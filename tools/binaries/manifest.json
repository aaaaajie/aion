    },
    "cyberchef": {
      "version": "11.2.0-aion-python",
      "path": "bin/cyberchef",
      "sha256": "5d8fc7239b136611331662b57a0a38aa6762e417d24483bda5e740ffade22cd8",
      "version_args": [
        "--version"
      ],
      "required": true,
      "version_pattern": "11.2.0-aion-python",
      "purpose": "Offline Python-native CyberChef crypto and encoding recipes"
    }
  }
}
