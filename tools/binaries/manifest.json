      "sha256": "094b65b2dfba47bb1c4da9df56ac1846d8e05ee59e79a13917f900d94f27d48d",
      "version_args": [
        "--help"
      ],
      "version_pattern": "usage: arjun",
      "source": "https://github.com/s0md3v/Arjun",
      "upstream_version": "2.2.7",
      "upstream_commit": "d1fb995cb1e064d4e171d83f19f6af79b0a3c5ce",
      "upstream_license": "AGPL-3.0",
