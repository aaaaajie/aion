# Build only the hosted black-box runtime. Local credentials, probes, state,
# Web UI files, VPN files, and operator tooling must never enter the context.
*
!.dockerignore
!Dockerfile
!pyproject.toml
!requirements.lock
!agent/
!agent/**
!challenges_sdk/
!challenges_sdk/**
!third_party/
!third_party/**
!tools/
!tools/**
!scripts/
!scripts/online_runtime.py
!docker/
!docker/entrypoint-hosted.sh
agent/api
agent/api/**
scripts/network_manager
scripts/network_manager/**
scripts/runtime_web
scripts/runtime_web/**
scripts/runtime_monitor.py
scripts/runs_download_server.py
scripts/quick_runtime_test.py
scripts/test_agent.py
scripts/export_run_bundle.py

**/__pycache__/
**/*.py[cod]
.git/
.venv/
.env
.env.*
.work/
work/
probe/
tests/
config/
deploy/
evidence/
baseline_evidence/
direction-probe/
direction_probe/
promptlab-probe/
rag_context_evidence/
sqli/
sqli2/
sqli_otherdb/
sqli_work/
*.jpg
*.png
*.html
*.bin
*.tsv
*_probe*.json
probe-*.json
!scripts/seal_enhanced_toolchain.py
!scripts/check_enhanced_toolchain.py

# Chromium runtime assets include .bin and HTML files.
!tools/binaries/playwright-browsers/**

!tools/binaries/cyberchef/**
!scripts/build_cyberchef_python.py
!scripts/check_cyberchef_toolchain.py
