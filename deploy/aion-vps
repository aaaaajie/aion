    _ssh(["python3", manager, "commit"])


def _rollback_pending(release_id: str) -> None:
    manager = f"/opt/aion/releases/{release_id}/deploy/release_manager.py"
    _ssh(["python3", manager, "rollback-pending"], check=False)


def _deploy(token: str, vpn: Path | None) -> None:
    _local_verify()
    _remote_doctor()
    before = _remote_state()
    package_hash = _package_hash()
    run = before.get("run") or {}
    was_active = bool(before.get("active"))
    run_id = run.get("run_id")
    if was_active and not run_id:
        raise OperatorError("active service has no discoverable persistent run")

    source_digest = _source_digest()
    release_id = _release_id(source_digest)
    venv_id = _requirements_digest()
    print(f"[deploy] staging release {release_id}", flush=True)
    _stage_release(release_id, venv_id)
    staged_vpn = _stage_vpn(vpn, release_id) if vpn else None
    activated = False
    try:
        if was_active:
            if before.get("release"):
                _ssh(["aionctl", "pause"])
            else:
                print("[deploy] first structured release: graceful legacy stop", flush=True)
                _ssh(["systemctl", "stop", "aion-online.service"])
        if staged_vpn:
            _switch_vpn(staged_vpn)
        _activate_release(release_id)
        activated = True
        if was_active and run.get("status") != "completed":
            _start_remote("resume", token, str(run_id))
            after = _wait_healthy(
                str(run_id),
                str(before.get("default_route", "")),
                required_running_challenges=set(before.get("running_challenges", [])),
            )
            if set(after.get("runs", [])) != set(before.get("runs", [])):
                raise OperatorError("deployment unexpectedly changed the set of run directories")
            if not set(before.get("running_challenges", [])).issubset(
                set(after.get("running_challenges", []))
            ):
                raise OperatorError("one or more running challenge containers were lost")
            _verify_token_absent(token)
        _remote_doctor()
        if _package_hash() != package_hash:
            raise OperatorError("routine deployment changed the host package manifest")
        _commit_release(release_id)
    except Exception:
        if _remote_state().get("active"):
            _ssh(["aionctl", "pause"], check=False)
        if activated:
            _rollback_pending(release_id)
        if staged_vpn:
            _restore_vpn()
        raise
    finally:
        if staged_vpn:
            _ssh(["rm", "-f", staged_vpn], check=False)
    print(f"[deploy] release {release_id} is active", flush=True)


def _replace_vpn_for_start(vpn: Path | None) -> bool:
    if vpn is None:
        return False
    identifier = datetime.now(timezone.utc).strftime("%Y%m%d%H%M%S") + "-vpn000000000"
    staged = _stage_vpn(vpn, identifier)
    _switch_vpn(staged)
    return True


def _start_command(mode: str, token: str, run_id: str | None, vpn: Path | None) -> None:
    before = _remote_state()
    if before.get("active"):
        raise OperatorError("AION is already active")
    changed_vpn = _replace_vpn_for_start(vpn)
    try:
        expected = _start_remote(mode, token, run_id)
        if expected == "latest":
            current = _remote_state().get("run") or {}
            expected = str(current.get("run_id") or "")
            if not expected:
                raise OperatorError("resumed run id could not be determined")
        _wait_healthy(expected, str(before.get("default_route", "")))
    except Exception:
        if changed_vpn:
            _restore_vpn()
        raise


def _restart(token: str, vpn: Path | None) -> None:
    before = _remote_state()
    run = before.get("run") or {}
    if not before.get("active") or not run.get("run_id"):
        raise OperatorError("restart requires an active persistent run")
    if run.get("status") == "completed":
        raise OperatorError("completed runs cannot be restarted; use start for a new run")
    _ssh(["aionctl", "pause"])
    changed_vpn = _replace_vpn_for_start(vpn)
    try:
        _start_remote("resume", token, str(run["run_id"]))
        _wait_healthy(str(run["run_id"]), str(before.get("default_route", "")))
    except Exception:
        if changed_vpn:
            _restore_vpn()
        raise


def _logs_pull(run_id: str, include_workspace: bool) -> Path:
    state = _remote_state()
    resolved = (state.get("run") or {}).get("run_id") if run_id == "latest" else run_id
    if not isinstance(resolved, str) or RUN_ID_PATTERN.fullmatch(resolved) is None:
        raise OperatorError("a valid run id is required to pull logs")
    destination_dir = LOCAL_LOG_ROOT / resolved
    destination_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    timestamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    destination = destination_dir / f"{timestamp}.tar.gz"
    temporary = destination.with_name(f".{destination.name}.tmp")
    command = ["aionctl", "bundle", "--run-id", resolved]
    if include_workspace:
        command.append("--include-workspace")
    try:
        with temporary.open("wb") as output:
            completed = subprocess.run(
                [*_ssh_base(), SSH_TARGET, shlex.join(command)],
                stdout=output,
                stderr=subprocess.PIPE,
            )
        if completed.returncode != 0:
            detail = completed.stderr.decode("utf-8", errors="replace").strip()
            raise OperatorError(f"remote log export failed: {detail}")
        temporary.chmod(0o600)
        os.replace(temporary, destination)
    finally:
        temporary.unlink(missing_ok=True)
    with tempfile.TemporaryDirectory(prefix="aion-log-check-") as directory:
        with tarfile.open(destination, "r:gz") as archive:
            member = archive.getmember("state.sqlite3")
            source = archive.extractfile(member)
            if source is None:
                raise OperatorError("log bundle does not contain a state snapshot")
            snapshot = Path(directory) / "state.sqlite3"
            snapshot.write_bytes(source.read())
        with sqlite3.connect(snapshot) as connection:
            result = connection.execute("PRAGMA integrity_check").fetchone()
        if result != ("ok",):
            raise OperatorError("downloaded SQLite snapshot failed integrity_check")
    digest = hashlib.sha256(destination.read_bytes()).hexdigest()
    print(f"{destination}  sha256={digest}")
    return destination


def _validate_share_username(value: str) -> str:
    if re.fullmatch(r"[A-Za-z0-9._-]{1,64}", value) is None:
        raise OperatorError("runs-share username contains invalid characters")
    return value


def _hash_share_password(password: bytes) -> bytes:
    if not password or b"\n" in password or b"\r" in password:
        raise OperatorError("runs-share password must be one non-empty line")
    result = _run(
        ["openssl", "passwd", "-apr1", "-stdin"],
        capture_output=True,
        input_data=password,
    )
    hashed = (result.stdout or b"").strip()
    if not hashed.startswith(b"$apr1$"):
        raise OperatorError("openssl did not return an Apache MD5 password hash")
    return hashed


def _upload_share_file(local: Path, remote: str) -> None:
    _run(
        ["scp", *_ssh_base()[1:], str(local), f"{SSH_TARGET}:{remote}"],
        cwd=PROJECT_ROOT,
    )


def _install_share_file(local: Path, target: str, mode: str) -> None:
    temporary = f"{RUNS_SHARE_ROOT}/.{Path(target).name}.incoming-{secrets.token_hex(6)}"
    _upload_share_file(local, temporary)
    try:
        _ssh(["install", "-o", "root", "-g", "root", "-m", mode, temporary, target])
    finally:
        _ssh(["rm", "-f", temporary], check=False)


def _install_share_credentials(username: str, hashed: bytes) -> None:
    entry = username.encode("ascii") + b":" + hashed + b"\n"
    script = """
import os
from pathlib import Path
import sys

target = Path('/etc/nginx/aion-runs.htpasswd')
temporary = target.with_name(f'.{target.name}.{os.getpid()}.tmp')
temporary.write_bytes(sys.stdin.buffer.read())
os.chmod(temporary, 0o640)
os.replace(temporary, target)
"""
    _ssh(["python3", "-c", script], input_data=entry)
    _ssh(["chown", "root:nginx", "/etc/nginx/aion-runs.htpasswd"])


def _runs_share(username: str, password: bytes) -> None:
    username = _validate_share_username(username)
    hashed = _hash_share_password(password)
    before = _remote_state()
    run_before = (before.get("run") or {}).get("run_id")
    if not before.get("active") or not run_before:
        raise OperatorError("runs-share requires the current AION Runtime to be active")

    _ssh(["install", "-d", "-o", "root", "-g", "root", "-m", "0755", RUNS_SHARE_ROOT])
    _install_share_file(
        PROJECT_ROOT / "scripts" / "runs_download_server.py",
        f"{RUNS_SHARE_ROOT}/runs_download_server.py",
        "0755",
    )
    _install_share_file(
        PROJECT_ROOT / "deploy" / "aion-runs.service",
        f"/etc/systemd/system/{RUNS_SHARE_SERVICE}",
        "0644",
    )
    backup_script = """
from pathlib import Path
import shutil

target = Path('/etc/nginx/conf.d/aion-monitor.conf')
backup = target.with_name('aion-monitor.conf.before-runs-share')
if target.is_file() and not backup.exists():
    shutil.copy2(target, backup)
"""
    _ssh(["python3", "-c", backup_script])
    _install_share_credentials(username, hashed)
    _install_share_file(
        PROJECT_ROOT / "deploy" / "aion-monitor.conf",
        "/etc/nginx/conf.d/aion-monitor.conf",
        "0644",
    )
    try:
        _ssh(["systemctl", "daemon-reload"])
        _ssh(["nginx", "-t"])
        _ssh(["systemctl", "enable", "--now", RUNS_SHARE_SERVICE])
        _ssh(["systemctl", "reload", "nginx"])
    except Exception:
        _ssh(["systemctl", "disable", "--now", RUNS_SHARE_SERVICE], check=False)
        _ssh(
            [
                "install",
                "-o",
                "root",
                "-g",
                "root",
                "-m",
                "0644",
                "/etc/nginx/conf.d/aion-monitor.conf.before-runs-share",
                "/etc/nginx/conf.d/aion-monitor.conf",
            ],
            check=False,
        )
        _ssh(["nginx", "-t"], check=False)
        _ssh(["systemctl", "reload", "nginx"], check=False)
        raise

    after = _remote_state()
    run_after = (after.get("run") or {}).get("run_id")
    if not after.get("active") or run_after != run_before:
        raise OperatorError("AION Runtime changed while enabling runs-share")
    print("runs-share: https://43.138.171.224:8443/runs/")
    print(f"runs-share: user={username}")
    print(f"runs-share: current run={run_after}")


def _release_state() -> dict[str, Any]:
    current = _remote_state().get("release")
    if not current or RELEASE_PATTERN.fullmatch(str(current)) is None:
        raise OperatorError("versioned AION release is not installed")
    manager = f"/opt/aion/releases/{current}/deploy/release_manager.py"
    result = _ssh(["python3", manager, "current", "--json"], capture_output=True)
    return json.loads(_decode(result))


def _rollback_release(token: str) -> None:
    releases = _release_state()
    history = releases.get("history") or []
    current = releases.get("current")
    candidates = [item for item in history if item != current]
    if not candidates:
        raise OperatorError("no previous successful release is available")
    target = candidates[-1]
    before = _remote_state()
    run = before.get("run") or {}
    was_active = bool(before.get("active"))
    if was_active:
        _ssh(["aionctl", "pause"])
    _activate_release(target)
    try:
        if was_active:
            _start_remote("resume", token, str(run.get("run_id")))
            _wait_healthy(str(run.get("run_id")), str(before.get("default_route", "")))
        _commit_release(target)
    except Exception:
        if _remote_state().get("active"):
            _ssh(["aionctl", "pause"], check=False)
        _rollback_pending(target)
        raise


def _build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)

    deploy = subparsers.add_parser("deploy")
    deploy.add_argument("--benchmark-token", required=True)
    deploy.add_argument("--vpn", type=Path)

    start = subparsers.add_parser("start")
    start.add_argument("--benchmark-token", required=True)
    start.add_argument("--vpn", type=Path)

    resume = subparsers.add_parser("resume")
    resume.add_argument("--benchmark-token", required=True)
    resume.add_argument("--run-id", default="latest")
    resume.add_argument("--vpn", type=Path)

    restart = subparsers.add_parser("restart")
    restart.add_argument("--benchmark-token", required=True)
    restart.add_argument("--vpn", type=Path)

    subparsers.add_parser("status")
    subparsers.add_parser("stop")

    logs = subparsers.add_parser("logs")
    logs_subparsers = logs.add_subparsers(dest="logs_command", required=True)
    tail = logs_subparsers.add_parser("tail")
    tail.add_argument("--follow", action="store_true")
    pull = logs_subparsers.add_parser("pull")
    pull.add_argument("--run-id", default="latest")
    pull.add_argument("--include-workspace", action="store_true")

    runs_share = subparsers.add_parser(
        "runs-share",
        help="enable the authenticated read-only run data download service",
    )
    runs_share.add_argument("--username", default="aion")
    runs_share.add_argument(
        "--password-stdin",
        action="store_true",
        required=True,
        help="read the Basic Auth password from stdin",
    )

    rollback = subparsers.add_parser("rollback")
    rollback.add_argument("--benchmark-token", required=True)
    subparsers.add_parser("doctor")
    return parser


def _validate_token(value: str) -> str:
    if not value or "\n" in value or "\r" in value:
        raise OperatorError("--benchmark-token must contain one non-empty line")
    return value


def main() -> None:
    try:
        _validate_local_access()
        args = _build_parser().parse_args()
        if args.command == "deploy":
            token = _validate_token(args.benchmark_token)
            args.benchmark_token = ""
            _deploy(token, args.vpn)
            token = ""
        elif args.command == "start":
            token = _validate_token(args.benchmark_token)
            args.benchmark_token = ""
            _start_command("fresh", token, None, args.vpn)
            token = ""
        elif args.command == "resume":
            token = _validate_token(args.benchmark_token)
            args.benchmark_token = ""
            _start_command("resume", token, args.run_id, args.vpn)
            token = ""
        elif args.command == "restart":
            token = _validate_token(args.benchmark_token)
            args.benchmark_token = ""
            _restart(token, args.vpn)
            token = ""
        elif args.command == "status":
            _ssh(["aionctl", "status"])
        elif args.command == "stop":
            _ssh(["aionctl", "stop"])
        elif args.command == "logs" and args.logs_command == "tail":
            command = ["aionctl", "logs"]
            if args.follow:
                command.append("--follow")
            _ssh(command)
        elif args.command == "logs" and args.logs_command == "pull":
            _logs_pull(args.run_id, args.include_workspace)
        elif args.command == "runs-share":
            password = sys.stdin.buffer.read()
            if password.endswith(b"\n"):
                password = password[:-1]
            _runs_share(args.username, password)
        elif args.command == "rollback":
            token = _validate_token(args.benchmark_token)
            args.benchmark_token = ""
            _rollback_release(token)
            token = ""
        elif args.command == "doctor":
            _remote_doctor()
            if _remote_state().get("release"):
                _ssh(["aionctl", "doctor"])
            print("AION VPS doctor checks passed")
    except (OperatorError, OSError, subprocess.CalledProcessError, json.JSONDecodeError) as exc:
        raise SystemExit(f"aion-vps: {exc}") from None


if __name__ == "__main__":
    main()
