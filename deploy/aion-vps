        raise


def _validate_vpn(path: Path) -> None:
    if path.suffix.lower() != ".ovpn" or not path.is_file():
        raise OperatorError("--vpn must reference a readable .ovpn file")
    if path.stat().st_size == 0 or path.stat().st_size > 1_000_000:
        raise OperatorError("OpenVPN profile size is invalid")
    forbidden = {
        "up",
        "down",
        "route-up",
        "route-pre-down",
        "ipchange",
        "learn-address",
        "client-connect",
        "client-disconnect",
        "auth-user-pass-verify",
        "tls-verify",
        "plugin",
        "script-security",
        "daemon",
        "writepid",
        "log",
        "log-append",
    }
    directives: set[str] = set()
    for raw_line in path.read_text(encoding="utf-8", errors="replace").splitlines():
        line = raw_line.strip()
        if not line or line.startswith(("#", ";", "<")):
            continue
        directives.add(line.split(maxsplit=1)[0].lstrip("-").lower())
    blocked = sorted(directives & forbidden)
    if blocked:
        raise OperatorError(
            "OpenVPN profile contains host-execution directives: " + ", ".join(blocked)
        )
    if "remote" not in directives or not ({"client", "pull"} & directives):
        raise OperatorError("OpenVPN profile does not look like a client profile")
    if "redirect-gateway" in directives:
        raise OperatorError("OpenVPN profile may not replace the host default route")


def _stage_vpn(path: Path, release_id: str) -> str:
    _validate_vpn(path)
    remote = f"/etc/aion/vpn/.incoming-{release_id}.ovpn"
    _run(["scp", *_ssh_base()[1:], str(path), f"{SSH_TARGET}:{remote}"])
    _ssh(["chown", "root:root", remote])
    _ssh(["chmod", "0600", remote])
    return remote


def _switch_vpn(staged: str) -> None:
    script = (
        "import os,pathlib,shutil; "
        f"source=pathlib.Path({staged!r}); target=pathlib.Path({str(VPN_CONFIG)!r}); "
        "backup=target.with_name('benchmark.ovpn.previous'); "
        "shutil.copy2(target,backup) if target.exists() else None; "
        "os.chmod(source,0o600); os.replace(source,target); os.chmod(target,0o600)"
    )
    _ssh(["python3", "-c", script])


def _restore_vpn() -> None:
    script = (
        "import os,pathlib; "
        f"target=pathlib.Path({str(VPN_CONFIG)!r}); "
        "backup=target.with_name('benchmark.ovpn.previous'); "
        "os.replace(backup,target) if backup.exists() else None"
    )
    _ssh(["python3", "-c", script], check=False)


def _start_remote(mode: str, token: str, run_id: str | None = None) -> str:
    if mode == "fresh" and run_id is None:
        run_id = f"online-{secrets.token_hex(6)}"
    command = ["aionctl", "start" if mode == "fresh" else "resume"]
    if mode == "fresh":
        command.extend(["--fresh", "--benchmark-token-stdin"])
        command.extend(["--run-id", str(run_id)])
    else:
        command.extend(["--run-id", run_id or "latest", "--benchmark-token-stdin"])
    _ssh(command, input_data=token.encode("utf-8"))
    return str(run_id or "latest")


def _wait_healthy(
    run_id: str,
    default_route: str,
    timeout: float = 90.0,
    required_running_challenges: set[str] | None = None,
) -> dict[str, Any]:
    deadline = time.monotonic() + timeout
    last: dict[str, Any] = {}
    while time.monotonic() < deadline:
        last = _remote_state()
        if not last.get("active"):
            state = last.get("service", {}).get("ActiveState")
            if state == "failed":
                break
        current = last.get("run") or {}
        if (
            last.get("active")
            and current.get("run_id") == run_id
            and last.get("monitor")
            and last.get("vpn")
            and (
                required_running_challenges is None
                or required_running_challenges.issubset(
                    set(current.get("running_challenges", []))
                )
            )
        ):
            if last.get("default_route") != default_route:
                raise OperatorError("VPN changed the host default route")
            return last
        time.sleep(1)
    _ssh(["journalctl", "-u", "aion-online.service", "-n", "80", "--no-pager"], check=False)
    raise OperatorError(f"AION did not become healthy for run {run_id}")


def _package_hash() -> str:
    result = _ssh(
        [
            "bash",
            "-lc",
            "rpm -qa --qf '%{NAME}-%{EPOCHNUM}:%{VERSION}-%{RELEASE}.%{ARCH}\\n' | sort | sha256sum",
        ],
        capture_output=True,
    )
    value = _decode(result).split(maxsplit=1)[0]
    if len(value) != 64:
        raise OperatorError("remote package manifest hash was invalid")
    return value


def _verify_token_absent(token: str) -> None:
    script = r"""
import pathlib, subprocess, sys
secret = sys.stdin.buffer.read()
if not secret: raise SystemExit(2)
targets = [pathlib.Path('/etc/aion/aion.env'), pathlib.Path('/etc/systemd/system/aion-online.service')]
root = pathlib.Path('/opt/aion/current')
targets.extend(path for path in root.rglob('*') if path.is_file() and path.stat().st_size <= 2_000_000)
for target in targets:
    try: data = target.read_bytes()
    except OSError: continue
    if secret in data: raise SystemExit(f'token found in {target}')
for path in pathlib.Path('/proc').glob('[0-9]*/cmdline'):
    try: data = path.read_bytes()
    except OSError: continue
    if secret in data: raise SystemExit(f'token found in {path}')
journal = subprocess.run(['journalctl','-u','aion-online.service','--no-pager'],capture_output=True).stdout
if secret in journal: raise SystemExit('token found in journal')
"""
    _ssh(["python3", "-c", script], input_data=token.encode("utf-8"))


def _activate_release(release_id: str) -> None:
    manager = f"/opt/aion/releases/{release_id}/deploy/release_manager.py"
    _ssh(["python3", manager, "activate", "--release-id", release_id])


def _commit_release(release_id: str) -> None:
