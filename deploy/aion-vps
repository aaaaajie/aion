class OperatorError(RuntimeError):
    pass


def _ssh_base() -> list[str]:
    return [
        "ssh",
        "-i",
        str(VPS_KEY),
        "-o",
        "IdentitiesOnly=yes",
        "-o",
        "BatchMode=yes",
        "-o",
        "StrictHostKeyChecking=yes",
        "-o",
        f"UserKnownHostsFile={KNOWN_HOSTS}",
    ]


def _rsync_shell() -> str:
    return shlex.join(_ssh_base())


def _run(
    command: list[str],
    *,
    check: bool = True,
    capture_output: bool = False,
    input_data: bytes | None = None,
    cwd: Path | None = None,
) -> subprocess.CompletedProcess[bytes]:
    return subprocess.run(
        command,
        check=check,
        stdout=subprocess.PIPE if capture_output else None,
        stderr=subprocess.PIPE if capture_output else None,
        input=input_data,
        cwd=cwd,
    )


def _ssh(
    remote_command: Iterable[str],
    *,
    check: bool = True,
    capture_output: bool = False,
    input_data: bytes | None = None,
) -> subprocess.CompletedProcess[bytes]:
    command = [*_ssh_base(), SSH_TARGET, shlex.join(list(remote_command))]
    return _run(
        command,
        check=check,
        capture_output=capture_output,
        input_data=input_data,
    )


def _decode(completed: subprocess.CompletedProcess[bytes]) -> str:
    return (completed.stdout or b"").decode("utf-8", errors="replace")


def _validate_local_access() -> None:
    if os.geteuid() == 0:
        raise OperatorError("run aion-vps as the local workspace user, not root")
    if not VPS_KEY.is_file() or not os.access(VPS_KEY, os.R_OK):
        raise OperatorError(f"SSH key is not readable: {VPS_KEY}")
    if not KNOWN_HOSTS.is_file() or not os.access(KNOWN_HOSTS, os.R_OK):
        raise OperatorError(f"pinned known-hosts file is not readable: {KNOWN_HOSTS}")


def _iter_source_files() -> list[Path]:
    files: list[Path] = []
    for name in SOURCE_NAMES:
        source = PROJECT_ROOT / name
        if not source.exists():
            raise OperatorError(f"required deployment source is missing: {name}")
        if source.is_file():
            files.append(source)
            continue
        for item in source.rglob("*"):
            relative_parts = item.relative_to(PROJECT_ROOT).parts
            if any(part in EXCLUDED_NAMES for part in relative_parts):
                continue
            if item.is_file() and item.suffix != ".pyc":
                files.append(item)
    return sorted(files, key=lambda item: item.relative_to(PROJECT_ROOT).as_posix())


def _source_digest() -> str:
    digest = hashlib.sha256()
    for path in _iter_source_files():
        relative = path.relative_to(PROJECT_ROOT).as_posix().encode("utf-8")
        digest.update(len(relative).to_bytes(4, "big"))
        digest.update(relative)
        with path.open("rb") as source:
            for chunk in iter(lambda: source.read(1024 * 1024), b""):
                digest.update(chunk)
    return digest.hexdigest()


def _release_id(source_digest: str) -> str:
    timestamp = datetime.now(timezone.utc).strftime("%Y%m%d%H%M%S")
    return f"{timestamp}-{source_digest[:12]}"


def _requirements_digest() -> str:
    return hashlib.sha256((PROJECT_ROOT / "requirements.lock").read_bytes()).hexdigest()


