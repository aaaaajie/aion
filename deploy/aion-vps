def _remote_state() -> dict[str, Any]:
    result = _ssh(
        ["python3", "-"],
        capture_output=True,
        input_data=REMOTE_STATE_SCRIPT.encode("utf-8"),
    )
    try:
        return json.loads(_decode(result))
    except json.JSONDecodeError as exc:
        raise OperatorError("remote state response was invalid") from exc


def _remote_doctor() -> None:
    script = (
        "set -euo pipefail; "
        "python3 -c 'import sys; raise SystemExit(sys.version_info[:2] != (3,11))'; "
        "command -v openvpn >/dev/null; command -v bwrap >/dev/null; "
        "command -v nginx >/dev/null; ! command -v nmap >/dev/null; "
        "test -d /etc/aion; test -d /var/lib/aion/workspace; "
        "test -d /var/lib/aion/runs; nginx -t >/dev/null"
    )
    _ssh(["bash", "-lc", script])


